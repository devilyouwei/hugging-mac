# 复制为 .env 后填写；不要提交真实密钥。
HUGGING_MAC_ENV=development
HUGGING_MAC_LOG_LEVEL=INFO
HUGGING_MAC_MODEL_HOME=./models
HUGGING_MAC_DATA_HOME=./data
HUGGING_MAC_ARTIFACT_HOME=./artifacts

# 如需访问受限模型，可在本地设置。
HF_TOKEN=

# 本地 Web 平台（FastAPI）
HUGGING_MAC_WEB_HOST=127.0.0.1
HUGGING_MAC_WEB_PORT=8000
HUGGING_MAC_WEB_LOG_LEVEL=INFO
HUGGING_MAC_WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HUGGING_MAC_WEB_RUNTIME_PREFERENCE=coreml,pytorch-mps
HUGGING_MAC_WEB_MODEL_HOME=./models
# 留空时使用 macOS 标准用户数据/缓存目录。
# HUGGING_MAC_WEB_DATA_DIR=./data/web
# HUGGING_MAC_WEB_CACHE_DIR=./data/cache
# HUGGING_MAC_WEB_DATABASE_PATH=./data/web/platform.json

# Object Detection App
HUGGING_MAC_APP_OBJECT_DETECTION_MODEL_ID=ultralytics/yolov8
HUGGING_MAC_APP_OBJECT_DETECTION_DEFAULT_CONFIDENCE=0.25
HUGGING_MAC_APP_OBJECT_DETECTION_DEFAULT_IOU_THRESHOLD=0.7
HUGGING_MAC_APP_OBJECT_DETECTION_DEFAULT_MAX_DETECTIONS=100
