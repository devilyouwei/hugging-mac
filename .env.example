# 复制为 .env 后填写；不要提交真实密钥。

# 如需访问受限模型，可在本地设置。
HF_TOKEN=

# 本地 Web 平台（FastAPI）
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_LOG_LEVEL=INFO
WEB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEB_RUNTIME_PREFERENCE=coreml,mlx,mps,onnx
WEB_MODEL_HOME=./models

# SenseVoice and Qwen3-ASR default to CPU-only for Core ML stability. Audio8-ASR
# keeps its model-specific cpu-and-neural-engine default.
APP_LIVE_TRANSCRIPTION_COREML_COMPUTE_UNITS=cpu-only
# 留空时使用 macOS 标准用户数据/缓存目录。
# WEB_DATA_DIR=./data/web
# WEB_CACHE_DIR=./data/cache
# WEB_DATABASE_PATH=./data/web/platform.json
